# AI Security Workflow Platform Environment Variables (uncflow)

PORT=3001
NODE_ENV=development

# PostgreSQL Connection Configuration
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/security_workflow
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=security_workflow

# Master key for AES-256-GCM Vault encryption (32 chars)
VAULT_SECRET_KEY=cyber-garden-2026-master-key-32b

# Сбер GigaChat API (Base64 Client ID + Secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Каналы связи: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Каналы связи: Яндекс Почта (smtp.yandex.ru:465)
YANDEX_MAIL_USER=
YANDEX_MAIL_PASSWORD=
YANDEX_MAIL_TO=

# Каналы связи: Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# =============================================================================
# UNCFLOW — КОНФИГУРАЦИЯ ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (.env)
# =============================================================================

# 1. Сервер и окружение
PORT=3001
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3001
CI_API_TOKEN=uncflow-ci-token-secret-2026
VAULT_SALT=cyber-garden-vault-salt-2026

# 2. База данных PostgreSQL (подключена и инициализирована по умолчанию в Docker)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/security_workflow
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=security_workflow

# 3. Мастер-ключ шифрования Vault (AES-256-GCM для защиты токенов и паролей в БД)
VAULT_SECRET_KEY=cyber-garden-2026-master-key-32b

# 4. Сбер GigaChat API (генерация AI-отчётов, OWASP/CWE анализ и патчи)
# Получить: https://developers.sber.ru/studio (раздел GigaChat API -> Авторизационные данные)
# Значение: Base64 строка (Client ID + Client Secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# 5. Канал связи: Telegram
# TELEGRAM_BOT_TOKEN: токен вашего бота от @BotFather (например: 123456789:ABCdefGhI...)
# TELEGRAM_CHAT_ID: ID вашего чата или канала (@channel_name или цифровой ID, например 123456789)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. Канал связи: Яндекс Почта (SMTP SSL порт 465)
# YANDEX_MAIL_USER: ваш логин или почта на Яндексе (например: security-bot@yandex.ru)
# YANDEX_MAIL_PASSWORD: пароль приложения из Яндекс ID (https://id.yandex.ru/security -> Пароли приложений -> Почта)
# YANDEX_MAIL_TO: email получателя отчётов (например: ciso@company.ru или ваш email)
YANDEX_MAIL_USER=
YANDEX_MAIL_PASSWORD=
YANDEX_MAIL_TO=

# 7. Канал связи: Исходящий Webhook (HTTP POST)
# WEBHOOK_URL: внешний URL приёмника (например: https://webhook.site/... или адрес вашей SIEM/CI)
# WEBHOOK_SECRET: секретный ключ для заголовка X-Security-Token
WEBHOOK_URL=
WEBHOOK_SECRET=

# 8. Токены для доступа к приватным репозиториям
# GITHUB_TOKEN: Personal Access Token (PAT) с правами 'repo' (https://github.com/settings/tokens)
# GITVERSE_TOKEN: Токен доступа GitVerse для приватных репозиториев
GITHUB_TOKEN=
GITVERSE_TOKEN=

# 9. GitHub OAuth авторизация в веб-интерфейсе (опционально)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
